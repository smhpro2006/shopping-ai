# Shopping AI — environment variable template
#
# Copy to .env and fill in real values. NEVER commit .env.
# In production these are set as Railway environment variables,
# not from a file.

# ---- Application ----
APP_NAME=Shopping AI
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---- Database ----
# Local development points at the Railway Postgres instance.
# On Railway, set this to the reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME

# ---- Security (Phase 11) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Retailer APIs (Phase 5) ----
# Leave blank until the corresponding programme is approved.
EBAY_APP_ID=
EBAY_CERT_ID=
BESTBUY_API_KEY=
WALMART_API_KEY=

# ---- Affiliate (Phase 22) ----
AMAZON_ASSOCIATE_TAG=

# ---- AI provider (Phase 15) ----
# Provider-agnostic: set only the one in use.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# ---- Collector (Phase 5) ----
COLLECTOR_INTERVAL_MINUTES=360
COLLECTOR_MAX_PRODUCTS=20
